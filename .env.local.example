NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only — NEVER prefix these with NEXT_PUBLIC_.
# The service role key bypasses row-level security; it must never reach the browser.
# From Supabase → Project Settings → API → service_role secret.
SUPABASE_SERVICE_ROLE_KEY=
# Comma-separated emails allowed to use the Admin tab and /api/admin routes.
ADMIN_EMAILS=
