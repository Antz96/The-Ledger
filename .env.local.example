NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Required for /connections (bank account linking via Enable Banking).
# Get the service role key from Supabase: Project Settings -> API -> service_role.
# Never expose this to the browser — it's only read in server-side API routes.
SUPABASE_SERVICE_ROLE_KEY=

# From Enable Banking's console (enablebanking.com) after registering an app
# and uploading its certificate.
ENABLE_BANKING_APP_ID=
# The private key generated alongside that certificate, PEM format, with
# real newlines replaced by literal \n so it fits on one line here, e.g.
# ENABLE_BANKING_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIEvQ...\n-----END PRIVATE KEY-----\n"
ENABLE_BANKING_PRIVATE_KEY=
# Must exactly match the redirect URI registered for the app in Enable
# Banking's console, e.g. http://localhost:3000/api/banking/callback for
# local dev, or https://yourdomain.com/api/banking/callback in production.
ENABLE_BANKING_REDIRECT_URI=
# Base URL of this app, used to build the redirect back into /connections
# after a bank connection completes. Defaults to the request origin if unset.
NEXT_PUBLIC_SITE_URL=

# Required for PDF statement/payslip extraction (Assets, Ledger, Allocate).
# Get a key from console.anthropic.com -> API Keys. Never expose this to the
# browser — it's only read server-side in /api/extract. Without it, the
# upload UI still renders but returns a clear "not configured yet" error.
ANTHROPIC_API_KEY=
